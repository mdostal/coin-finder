# PyInstaller build artifacts (packaging/pyinstaller/coin_finder_ui.spec) --
# regenerated with:
#   pyinstaller packaging/pyinstaller/coin_finder_ui.spec --distpath packaging/dist --workpath packaging/build
/packaging/build/
/packaging/dist/

# Tauri desktop shell (src-tauri/) build outputs -- none of this is meant
# to be committed; it's all regenerated by `npm install` + `npm run tauri
# build`/`dev`. `src-tauri/resources/coin-finder-onedir/` in particular is
# a ~150MB COPY of the PyInstaller onedir build output
# (packaging/dist/coin-finder-onedir/) staged here so Tauri's
# `bundle.resources` can pick it up -- see tauri.conf.json and
# src-tauri/binaries/coin-finder-sidecar-stub.sh for how it's consumed.
# Regenerate it with:
#   rm -rf src-tauri/resources/coin-finder-onedir && \
#     mkdir -p src-tauri/resources/coin-finder-onedir && \
#     cp -R packaging/dist/coin-finder-onedir/. src-tauri/resources/coin-finder-onedir/
node_modules/
src-tauri/target/
src-tauri/gen/
src-tauri/resources/coin-finder-onedir/

# Playwright MCP's own scratch output from manual smoke-testing pages -- never commit
.playwright-mcp/
